<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      QUERY_ALL_PACKAGES lets us enumerate every installed app so the drawer can
      list them. Required on Android 11+ (API 30) because of package visibility.
      Note: Google Play restricts this permission, but cheap head units almost
      never ship the Play Store, so sideloading is the norm here.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Only read network state for the Wi-Fi indicator; this WM build is offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Only WmLocalAdb uses sockets: fixed 127.0.0.1:5555, for home settings and
         foreground SOC compatibility reads / finite Bluetooth routing / tapped background cleanup.
         No Internet endpoints, weather fetching, background connection or service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="yftech.permission.USE_CARINFO" />
    <!-- Required by the OEM native SOC getter. Ordinary installs remain denied;
         grant is possible only with the OEM signature or a privileged install.
         This application sends no CarControl write transactions. -->
    <uses-permission android:name="yftech.permission.USE_CARCONTROL" />
    <uses-permission android:name="yftech.permission.USE_AIRCONDITION" />
    <uses-permission android:name="yftech.permission.USE_CARSETUP" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RadioLauncher">

        <receiver android:name=".WmBluetoothConnectionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.a2dp-sink.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service android:name=".WmHomeRepairService" android:exported="false" />
        <receiver android:name=".WmHomeBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.RadioLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME + DEFAULT is what makes Android offer this app as a launcher. -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          stateAlwaysHidden: the drawer opens on a grid of apps, not on the search
          field. Without it the search box takes first focus and the on-screen
          keyboard covers half the grid the moment the Apps tab is tapped.
        -->
        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".ParametersActivity"
            android:exported="false"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".FactoryAppsActivity"
            android:exported="false"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".CustomizeActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".TabOrderActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".GradientPickerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:parentActivityName=".HomeActivity" />

        <!--
          Empty notification listener. Its only job is to let the user grant
          "Notification access", which unlocks reading the active MediaSession so
          the media widget can show what's playing. Bound by the system only
          (protected by BIND_NOTIFICATION_LISTENER_SERVICE).
        -->
        <service
            android:name=".MediaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
