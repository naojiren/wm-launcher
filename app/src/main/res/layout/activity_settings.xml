<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Vehicle home entry settings always precede General. -->
            <LinearLayout style="@style/SettingsGroup">
                <LinearLayout android:id="@+id/rowWmWeike" style="@style/SettingsRow" android:minHeight="148dp"
                    android:paddingStart="24dp" android:paddingEnd="24dp"
                    android:paddingTop="20dp" android:paddingBottom="20dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsRowTitle" android:layout_width="match_parent"
                            android:layout_weight="0" android:text="@string/wm_weike_entry"
                            android:textSize="28sp" android:textStyle="bold" />
                        <TextView android:id="@+id/wmWeikeSummary" style="@style/SettingsRowTitle"
                            android:layout_width="match_parent" android:layout_weight="0"
                            android:textSize="20sp" android:textColor="@color/text_secondary"
                            android:layout_marginTop="10dp" android:text="@string/wm_weike_entry_description" />
                    </LinearLayout>
                    <com.dashline.launcher.WmEnabledSwitch android:id="@+id/wmWeikeSwitch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:minHeight="84dp" android:minWidth="120dp" android:layout_marginStart="20dp"
                        android:thumb="@drawable/wm_home_switch_thumb" app:track="@drawable/wm_home_switch_track"
                        app:thumbTint="@null" app:trackTint="@null" app:switchMinWidth="120dp"
                        android:contentDescription="@string/wm_weike_entry" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <LinearLayout android:id="@+id/rowWmDefaultHome" style="@style/SettingsRow" android:minHeight="148dp"
                    android:paddingStart="24dp" android:paddingEnd="24dp"
                    android:paddingTop="20dp" android:paddingBottom="20dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsRowTitle" android:layout_width="match_parent"
                            android:layout_weight="0" android:text="@string/wm_default_home"
                            android:textSize="28sp" android:textStyle="bold" />
                        <TextView android:id="@+id/wmDefaultHomeSummary" style="@style/SettingsRowTitle"
                            android:layout_width="match_parent" android:layout_weight="0"
                            android:textSize="20sp" android:textColor="@color/text_secondary"
                            android:layout_marginTop="10dp" android:text="@string/wm_default_home_description" />
                    </LinearLayout>
                    <com.dashline.launcher.WmEnabledSwitch android:id="@+id/wmDefaultHomeSwitch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" android:minHeight="84dp" android:minWidth="120dp" android:layout_marginStart="20dp"
                        android:thumb="@drawable/wm_home_switch_thumb" app:track="@drawable/wm_home_switch_track"
                        app:thumbTint="@null" app:trackTint="@null" app:switchMinWidth="120dp"
                        android:contentDescription="@string/wm_default_home" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== General ===== -->
            <TextView style="@style/SettingsSection" android:text="@string/section_general" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout android:id="@+id/rowWmBluetoothAudio" style="@style/SettingsRow" android:minHeight="112dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsRowTitle" android:layout_width="match_parent" android:layout_weight="0"
                            android:text="连接手机后自动开启蓝牙声音" android:textSize="26sp" />
                        <TextView style="@style/SettingsRowValue" android:layout_width="match_parent" android:textSize="20sp"
                            android:text="媒体蓝牙连接后切换一次，可关闭" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/wmBluetoothAudioSwitch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="80dp"
                        android:minWidth="120dp" app:switchMinWidth="100dp" android:contentDescription="自动开启蓝牙声音" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowLanguage" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_language" />
                    <TextView android:id="@+id/languageValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowTheme" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_theme" />
                    <TextView android:id="@+id/themeValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />
                <LinearLayout android:id="@+id/rowCustomize" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_customize" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowClockStyle" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_clock_style" />
                    <TextView android:id="@+id/clockStyleValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowChrono" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_chrono" />
                    <TextView android:id="@+id/chronoValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowTabs" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_tabs" />
                    <TextView android:id="@+id/tabsValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowGradient" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_gradient" />
                    <View
                        android:id="@+id/gradientSwatch"
                        android:layout_width="36dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="12dp" />
                    <TextView android:id="@+id/gradientValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowKeepOn" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_keep_on" />
                    <TextView android:id="@+id/keepOnValue" style="@style/SettingsRowValue" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Default apps ===== -->
            <TextView style="@style/SettingsSection" android:text="@string/section_apps" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout android:id="@+id/rowPhone" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_phone_app" />
                    <TextView android:id="@+id/phoneValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowNav" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_nav_app" />
                    <TextView android:id="@+id/navValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowRadio" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_radio_app" />
                    <TextView android:id="@+id/radioValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowMedia" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_media_app" />
                    <TextView android:id="@+id/mediaValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowAndroidAuto" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/wm_vehicle_control" />
                    <TextView android:id="@+id/androidAutoValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowCarPlay" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/wm_energy" />
                    <TextView android:id="@+id/carPlayValue" style="@style/SettingsRowValue" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Permissions ===== -->
            <TextView style="@style/SettingsSection" android:text="@string/section_access" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout android:id="@+id/rowNotificationAccess" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_notification_access" />
                    <TextView android:id="@+id/notificationAccessValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout android:id="@+id/rowDefaultLauncher" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_default_launcher" />
                    <TextView android:id="@+id/defaultLauncherValue" style="@style/SettingsRowValue" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== App drawer ===== -->
            <TextView style="@style/SettingsSection" android:text="@string/section_drawer" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout android:id="@+id/rowResetHidden" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_reset_hidden" />
                    <TextView android:id="@+id/resetHiddenValue" style="@style/SettingsRowValue" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== About ===== -->
            <TextView style="@style/SettingsSection" android:text="@string/wm_factory_apps" />
            <LinearLayout style="@style/SettingsGroup">
                <LinearLayout android:id="@+id/rowFactoryApps" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/wm_factory_apps" />
                    <TextView style="@style/SettingsRowValue" android:text="@string/media_tap_to_open" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <LinearLayout android:id="@+id/rowWmOrientation" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/wm_orientation" />
                    <TextView android:id="@+id/wmOrientationValue" style="@style/SettingsRowValue" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <LinearLayout android:id="@+id/rowWmSystemBars" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/wm_system_bars" />
                    <TextView android:id="@+id/wmSystemBarsValue" style="@style/SettingsRowValue" />
                </LinearLayout>
                <View style="@style/SettingsDivider" />
                <LinearLayout android:id="@+id/rowWmLicense" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/wm_license" />
                    <TextView style="@style/SettingsRowValue" android:text="@string/media_tap_to_open" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsSection" android:text="@string/section_about" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout android:id="@+id/rowVersion" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_version" />
                    <TextView android:id="@+id/versionValue" style="@style/SettingsRowValue" />
                </LinearLayout>

                <View android:id="@+id/updateDivider" style="@style/SettingsDivider" />

                <!-- Sideloaded builds only; hidden in the Play build, which updates
                     through Play. -->
                <LinearLayout android:id="@+id/rowCheckUpdates" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/settings_check_updates" />
                    <TextView android:id="@+id/checkUpdatesValue" style="@style/SettingsRowValue" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
